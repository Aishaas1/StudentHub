<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="StudentHub.MainWindow" Title="StudentHub | إدارة الطلاب" Width="1360" Height="840" MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" Background="{StaticResource CanvasBrush}">
    

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource NavyBrush}">
            <DockPanel Margin="22,32">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="StudentHub" FontSize="29" FontWeight="Bold" Foreground="White" FlowDirection="LeftToRight"/>
                    <TextBlock Text="نظام إدارة شؤون الطلاب" Foreground="#A5BAD5" Margin="0,6,0,34"/>
                    <Button Content="◈  لوحة التحكم" Command="{Binding NavigateCommand}" CommandParameter="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Page}" Value="0">
                                        <Setter Property="Background" Value="#246BCE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="♙  إدارة الطلاب" Command="{Binding NavigateCommand}" CommandParameter="1">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Page}" Value="1">
                                        <Setter Property="Background" Value="#246BCE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="▤  المواد الدراسية" Command="{Binding NavigateCommand}" CommandParameter="2">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Page}" Value="2">
                                        <Setter Property="Background" Value="#246BCE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="✓  الحضور والغياب" Command="{Binding NavigateCommand}" CommandParameter="3">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Page}" Value="3">
                                        <Setter Property="Background" Value="#246BCE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="▥  الدرجات والنتائج" Command="{Binding NavigateCommand}" CommandParameter="4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Page}" Value="4">
                                        <Setter Property="Background" Value="#246BCE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="ⓘ  عن المشروع" Command="{Binding NavigateCommand}" CommandParameter="5">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Page}" Value="5">
                                        <Setter Property="Background" Value="#246BCE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <Border Height="1" Background="#365071" Margin="0,20"/>
                    <TextBlock Text="مشروع جامعي · الإصدار 1.0" Foreground="#A5BAD5"/>
                    <TextBlock Text="بياناتك محفوظة على جهازك" Foreground="#A5BAD5" Margin="0,8"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E3EAF3" BorderThickness="0,0,0,1" Padding="28,18">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="↻ تحديث" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"/>
                    <StackPanel>
                        <TextBlock Text="بوابة الإدارة الأكاديمية" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="STUDENT MANAGEMENT SYSTEM" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" Padding="28,12" Background="White">
                <TextBlock Text="{Binding Status}" Foreground="#247A58"/>
            </Border>
            <TabControl SelectedIndex="{Binding Page}" BorderThickness="0" Background="Transparent">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.Resources>
                <TabItem>
                    <Grid Margin="28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="#10233F" CornerRadius="16" Padding="28" Margin="0,0,14,24">
                            <StackPanel>
                                <TextBlock Text="مساحة واحدة لإدارة الحياة الأكاديمية" FontSize="28" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="مرحبًا بك في StudentHub · نظرة واضحة على طلابك ونتائجهم" Foreground="#B9CDE8" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                        <UniformGrid Grid.Row="1" Columns="4">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="إجمالي الطلاب" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding StudentCount}" FontSize="36" FontWeight="Bold" Margin="0,12" Foreground="#246BCE"/>
                                    <TextBlock Text="طلاب مسجلون في النظام" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="المواد الدراسية" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding SubjectCount}" FontSize="36" FontWeight="Bold" Margin="0,12" Foreground="#246BCE"/>
                                    <TextBlock Text="مقررات الفصل الدراسي" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="سجلات الحضور" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding AttendanceCount}" FontSize="36" FontWeight="Bold" Margin="0,12" Foreground="#246BCE"/>
                                    <TextBlock Text="{Binding AttendanceDetail}" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="متوسط الدرجات" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding Average}" FontSize="36" FontWeight="Bold" Margin="0,12" Foreground="#246BCE"/>
                                    <TextBlock Text="من أصل 100 درجة" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Grid.Row="2" Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="أحدث الطلاب المضافين" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>
                                <DataGrid ItemsSource="{Binding RecentStudents}" SelectedItem="{Binding SelectedStudent}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="الرقم الجامعي" Binding="{Binding StudentNumber}" Width="125"/>
                                        <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="*"/>
                                        <DataGridTextColumn Header="القسم" Binding="{Binding Department}" Width="*"/>
                                        <DataGridTextColumn Header="المستوى" Binding="{Binding AcademicLevel}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem>
                    <Grid Margin="28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="إدارة الطلاب" Style="{StaticResource Title}"/>
                            <TextBlock Text="سجلات منظمة، ومعلومات يمكنك الوصول إليها بسهولة." Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,18">
                                <Button Content="＋ إضافة" Command="{Binding AddStudentCommand}"/>
                                <Button Content="✎ تعديل" Style="{StaticResource SecondaryButton}" Command="{Binding EditStudentCommand}"/>
                                <Button Content="حذف" Style="{StaticResource DangerButton}" Command="{Binding DeleteStudentCommand}"/>
                            </StackPanel>
                            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" ToolTip="البحث بالاسم أو الرقم الجامعي" Margin="0,0,14,16"/>
                            <TextBlock Text="ابحث بالاسم أو الرقم الجامعي · اختر صفًا للتعديل أو الحذف" Margin="0,0,0,12" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
                            <DataGrid ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الرقم الجامعي" Binding="{Binding StudentNumber}" Width="125"/>
                                    <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="*"/>
                                    <DataGridTextColumn Header="القسم" Binding="{Binding Department}" Width="*"/>
                                    <DataGridTextColumn Header="المستوى" Binding="{Binding AcademicLevel}" Width="80"/>
                                    <DataGridTextColumn Header="البريد الإلكتروني" Binding="{Binding Email}" Width="170"/>
                                    <DataGridTextColumn Header="الهاتف" Binding="{Binding PhoneNumber}" Width="125"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem>
                    <Grid Margin="28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="المواد الدراسية" Style="{StaticResource Title}"/>
                            <TextBlock Text="إدارة المقررات والساعات المعتمدة." Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,18">
                                <Button Content="＋ إضافة" Command="{Binding AddSubjectCommand}"/>
                                <Button Content="✎ تعديل" Style="{StaticResource SecondaryButton}" Command="{Binding EditSubjectCommand}"/>
                                <Button Content="حذف" Style="{StaticResource DangerButton}" Command="{Binding DeleteSubjectCommand}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
                            <DataGrid ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="رمز المادة" Binding="{Binding Code}" Width="160"/>
                                    <DataGridTextColumn Header="اسم المادة" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="الساعات المعتمدة" Binding="{Binding CreditHours}" Width="180"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem>
                    <Grid Margin="28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="الحضور والغياب" Style="{StaticResource Title}"/>
                            <TextBlock Text="سجل واحد لكل طالب ومادة وتاريخ؛ لا تسجيل مكرر." Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,18">
                                <Button Content="＋ إضافة" Command="{Binding AddAttendanceCommand}"/>
                                <Button Content="✎ تعديل" Style="{StaticResource SecondaryButton}" Command="{Binding EditAttendanceCommand}"/>
                                <Button Content="حذف" Style="{StaticResource DangerButton}" Command="{Binding DeleteAttendanceCommand}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
                            <DataGrid ItemsSource="{Binding Attendance}" SelectedItem="{Binding SelectedAttendance}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الطالب" Binding="{Binding Student.FullName}" Width="*"/>
                                    <DataGridTextColumn Header="المادة" Binding="{Binding Subject.Name}" Width="*"/>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="160"/>
                                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem>
                    <Grid Margin="28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="الدرجات والنتائج" Style="{StaticResource Title}"/>
                            <TextBlock Text="درجة واحدة لكل طالب ومادة، من صفر إلى 100." Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,18">
                                <Button Content="＋ إضافة" Command="{Binding AddGradeCommand}"/>
                                <Button Content="✎ تعديل" Style="{StaticResource SecondaryButton}" Command="{Binding EditGradeCommand}"/>
                                <Button Content="حذف" Style="{StaticResource DangerButton}" Command="{Binding DeleteGradeCommand}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Button Content="↓ تصدير CSV" Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButton}"/>
                                <TextBlock Text="{Binding StudentAverage}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
                            <DataGrid ItemsSource="{Binding Grades}" SelectedItem="{Binding SelectedGrade}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الرقم الجامعي" Binding="{Binding Student.StudentNumber}" Width="140"/>
                                    <DataGridTextColumn Header="الطالب" Binding="{Binding Student.FullName}" Width="*"/>
                                    <DataGridTextColumn Header="المادة" Binding="{Binding Subject.Name}" Width="*"/>
                                    <DataGridTextColumn Header="الدرجة / 100" Binding="{Binding Score}" Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="36">
                            <TextBlock Text="عن StudentHub" Style="{StaticResource Title}"/>
                            <Border Style="{StaticResource Card}" Margin="0,20">
                                <StackPanel>
                                    <TextBlock Text="STUDENTHUB" FontSize="36" FontWeight="Bold" Foreground="#246BCE"/>
                                    <TextBlock Text="إدارة الطلاب ببساطة ووضوح" FontSize="22" Margin="0,12"/>
                                    <TextBlock Text="مشروع جامعي لإدارة الطلاب والمواد والحضور والدرجات محليًا، مع حفظ دائم للبيانات وتصدير النتائج." TextWrapping="Wrap" FontSize="16"/>
                                    <Separator Margin="0,24"/>
                                    <TextBlock Text="التقنيات المستخدمة" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="C# · WPF / XAML · .NET 10 LTS SQLite · Entity Framework Core · CommunityToolkit.Mvvm" FlowDirection="LeftToRight" Margin="0,14" FontSize="16"/>
                                    <TextBlock Text="الهدف التعليمي" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="تطبيق مبسط لنمط MVVM والعلاقات بين الجداول والتحقق من البيانات وعمليات الإضافة والتعديل والحذف. لا يحتاج إلى اتصال بالإنترنت أو خادم خارجي أثناء الاستخدام." TextWrapping="Wrap" Margin="0,14"/>
                                    <TextBlock Text="تحفظ البيانات في %LocalAppData%\StudentHub\studenthub.db" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</Window>
